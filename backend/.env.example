# BKNR ERP — Backend Environment Configuration Template
# Copy this file to `backend/.env` and replace placeholder values.
# NEVER commit real passwords or production secret keys to version control.

# Application Environment (`development`, `test`, `production`)
# In `production`, missing secrets trigger immediate startup failure.
ENVIRONMENT=development

# Database Connection URL (PostgreSQL)
# Production format: postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=postgresql+psycopg2://postgres@localhost:5432/bknr_erp

# Session Secret Key (Used for signed session cookies & secure download tokens)
# Generate using: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change-this-to-a-secure-random-secret-key

# Deployment Token (Required for deployment lock API & release.sh)
DEPLOYMENT_TOKEN=change-this-to-a-secure-deploy-token

# Super-Admin Email Addresses (Comma-separated)
SUPER_ADMIN_EMAILS=admin@bknrerp.in,bknr.solutions@gmail.com

# Allowed CORS Origins (Comma-separated URLs for web & mobile clients)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://127.0.0.1:5173

# Redis Cache URL (Optional in dev; recommended for production)
# REDIS_URL=redis://localhost:6379/0

# Email Gateway Configuration (Brevo / SMTP)
# BREVO_API_KEY=your_brevo_api_key_here
# BREVO_SENDER_EMAIL=no-reply@bknrerp.in
# BREVO_SENDER_NAME=BKNR ERP
# SMTP_EMAIL=no-reply@bknrerp.in
# SMTP_PASSWORD=your_smtp_password_here
# SUPPORT_EMAIL=support@bknrerp.in

# Session Lifetime Configuration (Seconds)
SESSION_MAX_AGE_SECONDS=28800
SESSION_IDLE_TIMEOUT_SECONDS=1800
